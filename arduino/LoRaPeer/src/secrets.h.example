#ifndef SECRETS_H
#define SECRETS_H

// ==================== CREDENCIALES WIFI ====================
// Copia este archivo como 'secrets.h' y reemplaza con tus datos reales.
// 'secrets.h' está en el .gitignore para no subirlo a GitHub.
#define WIFI_SSID "TU_RED_WIFI"
#define WIFI_PASSWORD "TU_CONTRASEÑA"

// ==================== CREDENCIALES HIVEMQ CLOUD ====================
#define HIVEMQ_USER_NODE1 "LoraPeer1"
#define HIVEMQ_PASS_NODE1 "Lorapeer1"

#define HIVEMQ_USER_NODE2 "LoraPeer2"
#define HIVEMQ_PASS_NODE2 "Lorapeer2"

// ==================== CLAVE PUBLICA RSA (cifrado al broker) ====================
// Los mensajes publicados al broker se cifran con esta clave PUBLICA (e, n).
// Solo quien tenga la clave PRIVADA (d) puede descifrarlos.
// La placa NUNCA conoce 'd'. Genera tu propio par con dos primos grandes
// (que quepan en 32 bits, n <= 4294967295) y guarda 'd' fuera del dispositivo.
//
// Par de demostracion: p=60013, q=60017 => n=3601800221, e=65537,
//                      d=1778720129 (guardar SOLO en el consumidor del broker).
#define CLOUD_RSA_E 65537UL
#define CLOUD_RSA_N 3601800221UL

#endif
